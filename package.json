{
  "name": "openrampkit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "dev:example": "pnpm --filter next-demo dev",
    "coverage": "vitest run --coverage",
    "docs:dev": "pnpm --filter openrampkit-docs dev",
    "docs:build": "pnpm --filter openrampkit-docs build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "happy-dom": "^18.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}