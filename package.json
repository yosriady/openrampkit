{
  "name": "openrampkit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "dev:example": "pnpm --filter next-demo dev",
    "coverage": "vitest run --coverage",
    "test:chain": "vitest run packages/wagmi/src/anvil.test.ts",
    "chain:local": "node scripts/anvil.ts",
    "docs:dev": "pnpm --filter openrampkit-docs dev",
    "docs:build": "pnpm --filter openrampkit-docs build",
    "playground:dev": "pnpm --filter playground dev",
    "playground:build": "pnpm --filter playground build",
    "site:build": "bash scripts/build-site.sh",
    "changeset": "changeset",
    "release": "pnpm build && pnpm -r --filter \"./packages/**\" publish --access public",
    "smoke": "bash scripts/smoke-packages.sh",
    "live:relay": "pnpm --filter @openrampkit/adapter --filter @openrampkit/adapter-relay --filter @openrampkit/core build >/dev/null && node scripts/live-relay.mjs",
    "testnet:settle": "pnpm --filter @openrampkit/core --filter @openrampkit/adapter --filter @openrampkit/adapter-mock --filter @openrampkit/server --filter @openrampkit/client build >/dev/null && node scripts/testnet-settle.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "happy-dom": "^18.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
