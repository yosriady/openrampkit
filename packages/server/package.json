{
  "name": "@openrampkit/server",
  "version": "0.1.0",
  "description": "Self-hosted OpenRampKit server: one web-standard handler for Cloudflare Workers, Next.js, Node, Bun and Deno",
  "keywords": [
    "cloudflare-workers",
    "nextjs",
    "offramp",
    "onramp",
    "openrampkit",
    "server"
  ],
  "homepage": "https://github.com/yosriady/openrampkit/tree/main/docs/api/server.md",
  "bugs": {
    "url": "https://github.com/yosriady/openrampkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosriady/openrampkit.git",
    "directory": "packages/server"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@openrampkit/core": "workspace:*",
    "@openrampkit/adapter": "workspace:*"
  },
  "peerDependencies": {}
}
