{
  "name": "@openrampkit/adapter-mock",
  "version": "0.0.1",
  "description": "OpenRampKit Mock provider adapter for development and tests (moves no money)",
  "keywords": [
    "adapter",
    "mock",
    "onramp",
    "openrampkit"
  ],
  "homepage": "https://github.com/yosriady/openrampkit/tree/main/docs/adapters/mock.md",
  "bugs": {
    "url": "https://github.com/yosriady/openrampkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosriady/openrampkit.git",
    "directory": "packages/adapters/mock"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@openrampkit/core": "workspace:*",
    "@openrampkit/adapter": "workspace:*"
  },
  "peerDependencies": {}
}
