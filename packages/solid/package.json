{
  "name": "@openrampkit/solid",
  "version": "0.0.1",
  "description": "Solid wrapper for OpenRampKit: provider, Deposit and Withdraw buttons, primitives (SSR-safe)",
  "keywords": [
    "offramp",
    "onramp",
    "openrampkit",
    "solid",
    "solid-js"
  ],
  "homepage": "https://github.com/yosriady/openrampkit/tree/main/docs/api/solid.md",
  "bugs": {
    "url": "https://github.com/yosriady/openrampkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosriady/openrampkit.git",
    "directory": "packages/solid"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@openrampkit/client": "workspace:*",
    "@openrampkit/core": "workspace:*",
    "@openrampkit/web": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "@solidjs/testing-library": "^0.8.10"
  }
}
