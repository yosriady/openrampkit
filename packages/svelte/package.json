{
  "name": "@openrampkit/svelte",
  "version": "0.0.1",
  "description": "Svelte wrapper for OpenRampKit: stores, actions and context helpers for Svelte 5 and 4 (SSR-safe)",
  "keywords": [
    "offramp",
    "onramp",
    "openrampkit",
    "svelte",
    "sveltekit"
  ],
  "homepage": "https://github.com/yosriady/openrampkit/tree/main/docs/api/svelte.md",
  "bugs": {
    "url": "https://github.com/yosriady/openrampkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosriady/openrampkit.git",
    "directory": "packages/svelte"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@openrampkit/client": "workspace:*",
    "@openrampkit/core": "workspace:*",
    "@openrampkit/web": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.0.0"
  }
}
