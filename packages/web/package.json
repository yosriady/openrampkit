{
  "name": "@openrampkit/web",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/theme.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p .",
    "demo": "vite demo"
  },
  "dependencies": {
    "@openrampkit/core": "workspace:*",
    "@openrampkit/client": "workspace:*",
    "lit": "^3.3.0",
    "qrcode-generator": "^1.4.4"
  },
  "peerDependencies": {},
  "typesVersions": {
    "*": {
      "theme": [
        "./dist/theme.d.ts"
      ]
    }
  }
}
