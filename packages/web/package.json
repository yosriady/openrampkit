{
  "name": "@openrampkit/web",
  "version": "0.0.1",
  "description": "<openramp-modal> web component (Lit, Shadow DOM) for deposits and withdrawals",
  "keywords": [
    "lit",
    "offramp",
    "onramp",
    "openrampkit",
    "web-component"
  ],
  "homepage": "https://github.com/yosriady/openrampkit/tree/main/docs/api/web.md",
  "bugs": {
    "url": "https://github.com/yosriady/openrampkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosriady/openrampkit.git",
    "directory": "packages/web"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    },
    "./stripe-link": {
      "types": "./dist/stripe-link.d.ts",
      "import": "./dist/stripe-link.js",
      "require": "./dist/stripe-link.cjs"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/theme.ts src/stripe-link.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p .",
    "demo": "vite demo"
  },
  "dependencies": {
    "@openrampkit/core": "workspace:*",
    "@openrampkit/client": "workspace:*",
    "lit": "^3.3.0",
    "qrcode-generator": "^1.4.4"
  },
  "peerDependencies": {
    "@stripe/crypto": "^1.1.3"
  },
  "peerDependenciesMeta": {
    "@stripe/crypto": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stripe/crypto": "^1.1.3"
  },
  "typesVersions": {
    "*": {
      "theme": [
        "./dist/theme.d.ts"
      ],
      "stripe-link": [
        "./dist/stripe-link.d.ts"
      ]
    }
  }
}
