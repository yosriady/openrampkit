{
  "name": "@openrampkit/core",
  "version": "0.0.1",
  "description": "Types, exact money math, codes, region policy, flow table and pathway planner for OpenRampKit",
  "keywords": [
    "offramp",
    "onramp",
    "openrampkit",
    "payments",
    "planner"
  ],
  "homepage": "https://github.com/yosriady/openrampkit/tree/main/docs/api/core.md",
  "bugs": {
    "url": "https://github.com/yosriady/openrampkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosriady/openrampkit.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {},
  "peerDependencies": {}
}
