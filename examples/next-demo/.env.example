# 32+ random characters
OPENRAMP_SECRET=dev-secret-change-me-dev-secret-change-me
PUBLIC_URL=http://localhost:3000
# 1 = mock provider only (no real money, works offline). 0 = real Relay for wallet/transfer + mock fiat.
OPENRAMP_MOCK=1
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: real merchant pay-in through Xendit (use development keys)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Protects /api/cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Relay API key from https://dashboard.relay.link (API keys tab). Needed for deposit-address status
# (Relay retires the keyless /requests/v2 endpoint on 2026-11-24).
RELAY_API_KEY=
