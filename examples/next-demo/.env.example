# 32+ random characters
OPENRAMP_SECRET=dev-secret-change-me-dev-secret-change-me
PUBLIC_URL=http://localhost:3000
# Signs the webhooks to /api/hooks. 16+ random characters. Without it, the example uses a dev-only default.
# OPENRAMP_WEBHOOK_SECRET=replace-with-another-random-secret
# 1 = mock provider only (no real money, works offline). 0 = real Relay for wallet/transfer + mock fiat.
OPENRAMP_MOCK=1
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: real merchant pay-in through Xendit (use development keys)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Protects /api/cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Optional: admin tools and the ops dashboard at /api/openramp/admin. 32+ random characters.
# Keep it on the server. In production, put /admin behind your own auth or a VPN.
OPENRAMP_ADMIN_TOKEN=

# Relay API key from https://dashboard.relay.link (API keys tab). Needed for quotes (/quote/v2 needs a
# key since 2026-10-02) and for deposit-address status (Relay retires the keyless /requests/v2 on 2026-11-24).
RELAY_API_KEY=
