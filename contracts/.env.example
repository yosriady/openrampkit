# Copy to contracts/.env and fill in. Never commit .env.
DEPLOYER_PRIVATE_KEY=
# Optional: owner of the contract (default: the deployer). Use a multisig for production.
# SETTLEMENT_OWNER=0x...
# Optional: address of the OpenRampKit server intent signer (default: none, intents off)
# SETTLEMENT_INTENT_SIGNER=0x...
# Optional: comma-separated call targets to allow, e.g. ERC-4626 vaults
# SETTLEMENT_ALLOWED_TARGETS=0x...,0x...

# Arbiscan (Etherscan v2 key works) for --verify on Arbitrum
ARBISCAN_API_KEY=
